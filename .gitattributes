# LF in every working tree, whatever core.autocrlf says. `deno fmt` writes LF, so a CRLF checkout fails
# `deno fmt --check` on every file; and generators copy asset sources (packages/*/assets, see
# packages/core/src/utils/asset-manager.ts) byte-for-byte into the byte-exact snapshots, so a CRLF
# asset turns every snapshot that contains it into a diff. The `-text` rules below override this.
* text=auto eol=lf

# Generated snapshot trees. Comparison is byte-exact, so git must never normalize line endings in
# either direction on checkout or on commit; `-text` (not `eol=lf`) keeps a Windows checkout from
# mangling the tree that CI validates on Linux, without git rewriting CRLFs back out at commit time.
test/output/** -text
test/output/** linguist-generated=true

# Compile-gate diagnostics (tier 3, see test/README.md). Same reasoning as test/output/** above: these
# are compiler output, not source, and must not have line endings rewritten in either direction.
test/compile/** linguist-generated
test/compile/** -text

# Tier-4 wire deviations (see test/README.md). Generated comparison output, not source; same
# line-ending reasoning as test/output/** and test/compile/** above.
test/wire/** linguist-generated
test/wire/** -text
