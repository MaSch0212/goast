{
  "name": "goast-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "build:core": "pnpm --filter @goast/core build",
    "build:kotlin": "pnpm --filter @goast/kotlin build",
    "build:typescript": "pnpm --filter @goast/typescript build",
    "pack:npm": "pnpm --filter \"./packages/*\" exec pnpm pack --pack-destination ../../npm",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/integration/fetch-clients/tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:core": "vitest run packages/core",
    "test:kotlin": "vitest run packages/kotlin",
    "test:typescript": "vitest run packages/typescript",
    "test:harness": "vitest run test/harness",
    "test:harness:docker": "GOAST_COMPILE=1 vitest run test/harness/docker.test.ts",
    "test:unit": "vitest run packages",
    "test:cases": "vitest run test/cases",
    "test:output": "GOAST_SNAPSHOT=write vitest run test/output-tests",
    "test:output:check": "GOAST_SNAPSHOT=check vitest run test/output-tests",
    "test:compile": "GOAST_COMPILE=1 GOAST_SNAPSHOT=write vitest run test/compile-tests test/harness/docker.test.ts",
    "test:compile:check": "GOAST_COMPILE=1 GOAST_SNAPSHOT=check vitest run test/compile-tests test/harness/docker.test.ts",
    "test:compile:host": "GOAST_COMPILE=1 GOAST_SNAPSHOT=check vitest run test/compile-tests -t \"typescript/host\"",
    "test:compile:discovery": "GOAST_COMPILE=1 vitest run test/compile-tests -t \"unit discovery\"",
    "test:compile:support": "vitest run test/compile-tests/orphans.test.ts test/compile-tests/runners",
    "test:compile:ts:check": "pnpm test:compile:discovery && GOAST_COMPILE=1 GOAST_SNAPSHOT=check vitest run test/compile-tests -t \"typescript/\"",
    "test:compile:kotlin:check": "pnpm test:compile:discovery && pnpm test:compile:support && GOAST_COMPILE=1 GOAST_SNAPSHOT=check vitest run test/compile-tests -t \"kotlin \\(gradle\\)\"",
    "test:compile:cold": "GOAST_GRADLE_CACHE=0 GOAST_COMPILE=1 GOAST_SNAPSHOT=check vitest run test/compile-tests test/harness/docker.test.ts",
    "test:compile:clean": "node --conditions=source scripts/clean-gradle-work.ts",
    "test:integration": "GOAST_SNAPSHOT=write vitest run test/integration test/integration-tests",
    "test:integration:check": "GOAST_SNAPSHOT=check vitest run test/integration test/integration-tests",
    "test:integration:kotlin": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=write vitest run test/integration/kotlin-clients",
    "test:integration:kotlin:check": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=check vitest run test/integration/kotlin-clients",
    "test:integration:angular": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=write vitest run test/integration/angular-services",
    "test:integration:angular:check": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=check vitest run test/integration/angular-services",
    "test:integration:controllers": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=write vitest run test/integration/spring-controllers",
    "test:integration:controllers:check": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=check vitest run test/integration/spring-controllers",
    "test:integration:k6": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=write vitest run test/integration/k6-clients",
    "test:integration:k6:check": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=check vitest run test/integration/k6-clients",
    "test:integration:stubs": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=write vitest run test/integration/easy-network-stub",
    "test:integration:stubs:check": "GOAST_INTEGRATION=1 GOAST_SNAPSHOT=check vitest run test/integration/easy-network-stub",
    "test:check": "GOAST_SNAPSHOT=check vitest run",
    "test:all": "pnpm test:check && pnpm test:compile:check && pnpm test:integration:check && pnpm test:integration:kotlin:check && pnpm test:integration:controllers:check && pnpm test:integration:angular:check && pnpm test:integration:k6:check && pnpm test:integration:stubs:check",
    "pg": "node --conditions=source playground.ts"
  },
  "devDependencies": {
    "@goast/core": "workspace:*",
    "@goast/kotlin": "workspace:*",
    "@goast/test-harness": "workspace:*",
    "@goast/typescript": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "fs-extra": "^11.3.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "yaml": "^2.5.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
