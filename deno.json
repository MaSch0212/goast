{
  "tasks": {
    "npm:test-harness": "deno run -A scripts/build_npm.ts test/harness",
    "npm:core": "deno run -A scripts/build_npm.ts packages/core",
    "npm:kotlin": "deno run -A scripts/build_npm.ts packages/kotlin",
    "npm:typescript": "deno run -A scripts/build_npm.ts packages/typescript",
    "npm": "deno task npm:test-harness && deno task npm:core && deno task npm:typescript && deno task npm:kotlin",
    "npm:publish:core": "deno run -A scripts/publish_npm.ts @goast/core",
    "npm:publish:kotlin": "deno run -A scripts/publish_npm.ts @goast/kotlin",
    "npm:publish:typescript": "deno run -A scripts/publish_npm.ts @goast/typescript",
    "test": "deno test -A",
    "test:core": "deno test -A packages/core",
    "test:kotlin": "deno test -A packages/kotlin",
    "test:typescript": "deno test -A packages/typescript",
    "test:harness": "deno test -A test/harness",
    "pg": "deno run -A playground.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41.3",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/bytes": "jsr:@std/bytes@^1.0.5",
    "@std/expect": "jsr:@std/expect@^1.0.5",
    "@std/testing": "jsr:@std/testing@^1.0.4",
    "@std/text": "jsr:@std/text@^1.0.7",
    "@std/fs": "jsr:@std/fs@^1.0.22",
    "@std/fs/ensure-dir": "jsr:@std/fs@^1.0.22/ensure-dir",
    "@std/fs/walk": "jsr:@std/fs@^1.0.22/walk",
    "@types/node": "npm:@types/node@^22.7.5",
    "fs-extra": "npm:fs-extra@^11.3.3",
    "http-status-codes": "npm:http-status-codes@^2.3.0",
    "yaml": "npm:yaml@^2.5.1"
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "exclude": ["npm/**/*", "out/**/*", "coverage/**/*", ".verify/**/*", "docs/superpowers/**", "test/output/**"]
  },
  "lint": {
    "exclude": [
      "npm/**/*",
      "out/**/*",
      "coverage/**/*",
      ".verify/**/*",
      "test/output/**",
      "playground.ts",
      "**/assets/**/*"
    ]
  },
  "test": {
    "include": ["packages", "test"],
    "exclude": ["test/output"]
  },
  "workspace": [
    "packages/core",
    "packages/kotlin",
    "packages/typescript",
    "test/harness"
  ]
}
